# ==============================================================================
# FurniShop Backend Production Environment Configuration
# Set these variables in your cloud hosting provider dashboard (Railway, Render, etc.)
# or copy to backend/.env on your server.
# ==============================================================================

# Database Connection (from your cloud MariaDB / MySQL provider)
DB_HOST=
DB_PORT=3306
DB_NAME=furnishop
DB_USER=
DB_PASS=

# Allowed Origin for CORS (comma-separated; must include your live frontend)
ALLOWED_ORIGIN=https://furnishop-brown.vercel.app

# Optional: Persistent Cloud Media Storage (Cloudinary - Recommended)
# Obtain credentials from your Cloudinary Dashboard (https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=furnishop/products

# Optional: Public URL of the backend (e.g., https://furnishop-api.up.railway.app)
# APP_URL=https://<your-backend-service-domain>
