# FurniShop backend environment configuration
# Copy this file to backend/.env and adjust values as needed.
# start-backend.bat loads backend/.env into the PHP process environment.

# Development (local MariaDB on port 3307 - the project's own instance)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=furnishop
DB_USER=root
DB_PASS=

# PHP built-in server port for the API
API_PORT=8000

# Production example (uncomment and fill in):
# DB_HOST=your-production-host
# DB_PORT=3306
# DB_NAME=your_database
# DB_USER=your_user
# DB_PASS=your_password
