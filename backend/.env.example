# ==============================================================================
# FurniShop Backend Environment Configuration
# Copy this file to backend/.env and adjust values as needed.
# NEVER commit real credentials to Git!
# ==============================================================================

# Database Connection (Default: isolated project MariaDB on port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=furnishop
DB_USER=root
DB_PASS=

# API Server Port
API_PORT=8001

# Allowed Origins for CORS (comma-separated without trailing slash)
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://furnishop-brown.vercel.app

# ==============================================================================
# Persistent Production Media Storage (Cloudinary / AWS S3)
# Uploaded images will be permanently stored in cloud object storage,
# remaining accessible across server reboots, redeployments, and rebuilds.
# ==============================================================================

# Option 1: Cloudinary (Recommended - Free & persistent)
# Sign up at https://cloudinary.com/ and obtain credentials from your Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, set the single connection string:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=furnishop/products

# Option 2: AWS S3 or S3-Compatible Storage (Cloudflare R2, MinIO, Wasabi)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_S3_CUSTOM_DOMAIN=

# Public Media / Backend Base URL (Used for local storage in production or custom CDN)
# MEDIA_BASE_URL=https://api.yourdomain.com
# APP_URL=http://127.0.0.1:8001

# Razorpay Payment Gateway (Phase 2 - keep SECRET strictly on backend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
