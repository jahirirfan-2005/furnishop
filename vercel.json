{
  "rewrites": [
    {
      "source": "/backend/api/health.php",
      "destination": "/api/health"
    },
    {
      "source": "/backend/api/:match*",
      "destination": "/api/gateway?route=:match*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
